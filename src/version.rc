#include <winver.h>
#include "version.hpp"
1 VERSIONINFO
FILEVERSION MIST_VERSION_NUMBERS
PRODUCTVERSION MIST_VERSION_NUMBERS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MistForest tactical game\0"
            VALUE "FileVersion", MIST_VERSION_LABEL "\0"
            VALUE "InternalName", "MistForest\0"
            VALUE "OriginalFilename", "MistForest_v" MIST_VERSION_LABEL ".exe\0"
            VALUE "ProductName", "MistForest\0"
            VALUE "ProductVersion", MIST_VERSION_LABEL "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

#include "portraits.rc"
