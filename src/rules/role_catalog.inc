std::wstring coordinate(Mode mode, int cell) {
    if (cell <= 0)
        return L"隐藏";
    return L"(" + std::to_wstring((cell - 1) / size(mode) + 1) + L"," +
           std::to_wstring((cell - 1) % size(mode) + 1) + L")";
} // 对外使用行列坐标。

std::wstring halfPoints(double value) {
    std::wostringstream out;
    out << std::fixed << std::setprecision(3) << value / 2;
    auto s = out.str();
    while (s.size() > 1 && s.back() == L'0')
        s.pop_back();
    if (s.back() == L'.')
        s.pop_back();
    return s;
} // 内部以半点为单位的浮点数支持零点六及三人平摊，显示三位有效小数。

